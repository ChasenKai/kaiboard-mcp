{
  "name": "@kaibuddy/kaiboard-core",
  "version": "0.4.0",
  "description": "Storage-agnostic command core for KaiBoard agent co-drawing: 11 commands driven through a pluggable storage adapter.",
  "keywords": [
    "kaiboard",
    "mcp",
    "model-context-protocol",
    "excalidraw",
    "whiteboard",
    "ai-agent",
    "local-first"
  ],
  "license": "MIT",
  "author": "ChasenKai",
  "homepage": "https://github.com/ChasenKai/kaiboard-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChasenKai/kaiboard-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ChasenKai/kaiboard-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "*",
    "@excalidraw/mermaid-to-excalidraw": "*"
  },
  "peerDependenciesMeta": {
    "@excalidraw/excalidraw": {
      "optional": true
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "optional": true
    }
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
