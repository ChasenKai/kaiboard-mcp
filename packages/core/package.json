{
  "name": "@kaiboard/core",
  "version": "1.0.0",
  "description": "Storage-agnostic Agent co-drawing command core for KaiBoard (9 commands, StorageAdapter-driven).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "*",
    "@excalidraw/mermaid-to-excalidraw": "*"
  },
  "peerDependenciesMeta": {
    "@excalidraw/excalidraw": {
      "optional": true
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "optional": true
    }
  },
  "license": "MIT"
}
