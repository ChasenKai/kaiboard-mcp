{
  "name": "@kaibuddy/kaiboard-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.ChasenKai/kaiboard-mcp",
  "description": "KaiBoard MCP server: let AI agents draw on your local KaiBoard whiteboards over stdio JSON-RPC. --relay drives the live board; --dir works in a local folder.",
  "keywords": [
    "kaiboard",
    "mcp",
    "model-context-protocol",
    "excalidraw",
    "whiteboard",
    "ai-agent",
    "local-first"
  ],
  "license": "MIT",
  "author": "ChasenKai",
  "homepage": "https://github.com/ChasenKai/kaiboard-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChasenKai/kaiboard-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ChasenKai/kaiboard-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kaiboard-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@kaibuddy/kaiboard-core": "^0.1.1"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "*",
    "@excalidraw/mermaid-to-excalidraw": "*"
  },
  "peerDependenciesMeta": {
    "@excalidraw/excalidraw": {
      "optional": true
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "optional": true
    }
  },
  "type": "module"
}
