{
  "name": "@kaiboard/mcp-server",
  "version": "0.1.0",
  "description": "KaiBoard MCP server (local --dir binding): stdio JSON-RPC + fsStorageAdapter, reusing @kaiboard/core.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "kaiboard-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@kaiboard/core": "^0.1.0"
  },
  "peerDependencies": {
    "@excalidraw/excalidraw": "*",
    "@excalidraw/mermaid-to-excalidraw": "*"
  },
  "peerDependenciesMeta": {
    "@excalidraw/excalidraw": {
      "optional": true
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "optional": true
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
